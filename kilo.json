{
  "$schema": "https://app.kilo.ai/config.json",
  "skills": {
    "paths": ["./.kilo/skills"]
  },
  "mcp": {
    "androidbuild": {
      "type": "local",
      "command": ["npx", "-y", "@dev-jackson/androidbuild-mcp"],
      "enabled": true,
      "timeout": 120000
    },
    "android-adb": {
      "type": "local",
      "command": ["npx", "-y", "@iksnerd/adb-mcp"],
      "enabled": true,
      "timeout": 60000,
      "environment": {
        "ANDROID_HOME": "/home/yu/Android/Sdk",
        "ANDROID_MCP_ALLOW_WRITE": "true"
      }
    },
    "humanizer": {
      "type": "local",
      "command": ["uvx", "humanizer-mcp"],
      "enabled": true,
      "timeout": 60000
    }
  },
  "permission": {
    "bash": {
      "./nova-build.sh *": "allow"
    },
    "*": {
      "*": "allow"
    }
  }
}